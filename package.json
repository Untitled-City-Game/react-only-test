{
  "name": "parcel-react-client-starter",
  "private": true,
  "version": "0.0.0",
  "source": "src/index.html",
  "scripts": {
    "sass": "sass --watch src/styles/interface.scss src/styles/interface.css",
    "start": "parcel --no-cache",
    "dev": "dotenvx run -f .env.development -- parcel --no-cache",
    "staging": "dotenvx run -f .env.staging -- parcel --no-cache",
    "build": "parcel build ./src/index.html --no-cache",
    "deploy": "dotenvx run -- npm run build && firebase deploy --project=prod",
    "stage": "dotenvx run -f .env.staging -- npm run build && firebase deploy",
    "serve": "tsx --env-file .env.development server/server.ts",
    "build-server": "esbuild server/server.ts --bundle --platform=node --outfile=build/server.js --packages=external",
    "start-server": "node --env-file=.env build/server.js",
    "start-dev-server": "node --env-file=.env.development build/server.js",
    "serve-dev": "npm run build-server && npm run start-dev-server",
    "start-staging-server": "node --env-file=.env.staging build/server.js",
    "build-location": "esbuild server/locationServer.ts --bundle --platform=node --outfile=build/locationServer.js --external:./node_modules/*",
    "start-location": "node --env-file=.env build/locationServer.js",
    "start-dev-location": "node --env-file=.env.development build/locationServer.js",
    "start-staging-location": "node --env-file=.env.staging build/locationServer.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.1",
    "@mantine/core": "^7.17.2",
    "@mantine/form": "^7.17.2",
    "@mantine/hooks": "^7.17.2",
    "@parcel/config-default": "^2.16.0",
    "@tmcw/togeojson": "^7.0.0",
    "@turf/turf": "^7.2.0",
    "@types/lodash": "^4.17.16",
    "@types/point-in-polygon": "^1.1.5",
    "@types/polylabel": "^1.1.3",
    "@vis.gl/react-google-maps": "^1.5.2",
    "boardgame.io": "^0.50.2",
    "cross-env": "^7.0.3",
    "csvjson-csv2json": "^5.0.6",
    "esbuild": "^0.25.12",
    "firebase": "^11.5.0",
    "lodash": "^4.17.21",
    "node-persist": "^4.0.4",
    "point-in-polygon": "^1.1.0",
    "polylabel": "^2.0.1",
    "react": "^19.0.0",
    "react-countdown": "^2.3.6",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^5.0.0",
    "react-geolocated": "^4.3.0",
    "react-icons": "^5.5.0",
    "react-player": "^2.16.0",
    "react-router": "^7.4.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.8.2",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/xmldom": "^0.1.34",
    "buffer": "^6.0.3",
    "parcel": "^2.14.1",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "process": "^0.11.10",
    "tsx": "^4.20.3"
  }
}
