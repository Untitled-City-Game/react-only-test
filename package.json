{
  "name": "parcel-react-client-starter",
  "private": true,
  "version": "0.0.0",
  "source": "src/index.html",
  "scripts": {
    "start": "cross-env APP_ENVIRONMENT=dev parcel --no-cache",
    "test-map": "parcel testmap/testmap.html",
    "build": "parcel build ./src/index.html --no-optimize --no-cache",
    "deploy": "cross-env APP_ENVIRONMENT=prod npm run build && firebase deploy --project=prod",
    "stage": "cross-env APP_ENVIRONMENT=stage npm run build && firebase deploy",
    "serve": "tsx --env-file .env --env-file .env.development server/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^7.17.2",
    "@mantine/form": "^7.17.2",
    "@mantine/hooks": "^7.17.2",
    "@mantine/modals": "^7.17.2",
    "@tmcw/togeojson": "^7.0.0",
    "@turf/turf": "^7.2.0",
    "@types/lodash": "^4.17.16",
    "@types/point-in-polygon": "^1.1.5",
    "@types/polylabel": "^1.1.3",
    "@vis.gl/react-google-maps": "^1.5.2",
    "bgio-firebase": "^0.5.0",
    "boardgame.io": "^0.50.2",
    "firebase": "^11.5.0",
    "lodash": "^4.17.21",
    "node-persist": "^4.0.4",
    "point-in-polygon": "^1.1.0",
    "polylabel": "^2.0.1",
    "react": "^19.0.0",
    "react-countdown": "^2.3.6",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^5.0.0",
    "react-firebase-hooks": "^5.1.1",
    "react-router": "^7.4.0",
    "type-fest": "^4.40.0",
    "typescript": "^5.8.2",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/xmldom": "^0.1.34",
    "buffer": "^6.0.3",
    "parcel": "^2.14.1",
    "parse2-kmz": "^1.0.7",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "process": "^0.11.10",
    "tailwindcss": "^4.0.15",
    "ts-toolbelt": "^9.6.0",
    "tsx": "^4.19.3"
  }
}
