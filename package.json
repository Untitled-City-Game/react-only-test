{
  "name": "parcel-react-client-starter",
  "private": true,
  "version": "0.0.0",
  "source": "src/index.html",
  "scripts": {
    "sass": "sass --watch src/styles/interface.scss src/styles/interface.css",
    "start": "concurrently --kill-others \"npm run sass\" \"parcel --no-cache \"",
    "start-stage": "concurrently --kill-others \"npm run sass\" \"parcel --no-cache \"",
    "dev": "cross-env APP_ENVIRONMENT=dev parcel --no-cache",
    "build": "parcel build ./src/index.html --no-cache",
    "deploy": "cross-env APP_ENVIRONMENT=prod npm run build && firebase deploy --project=prod",
    "deploy-dev": "cross-env APP_ENVIRONMENT=prod npm run build && firebase deploy --project=dev",
    "stage": "npm run build && firebase deploy",
    "serve": "tsx --env-file .env.development --inspect server/server.ts",
    "build-server": "esbuild server/server.ts --bundle --platform=node --outfile=build/server.js --external:./node_modules/*",
    "start-server": "node --env-file=.env build/server.js",
    "start-dev-server": "node --env-file=.env.development build/server.js",
    "start-staging-server": "node --env-file=.env.staging build/server.js",
    "build-location": "esbuild server/locationServer.ts --bundle --platform=node --outfile=build/locationServer.js --external:./node_modules/*",
    "start-location": "node --env-file=.env build/locationServer.js",
    "start-dev-location": "node --env-file=.env.development build/locationServer.js",
    "start-staging-location": "node --env-file=.env.staging build/locationServer.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^7.17.2",
    "@mantine/form": "^7.17.2",
    "@mantine/hooks": "^7.17.2",
    "@mantine/modals": "^7.17.2",
    "@parcel/service-worker": "^2.15.4",
    "@parcel/transformer-sass": "^2.15.1",
    "@tmcw/togeojson": "^7.0.0",
    "@turf/turf": "^7.2.0",
    "@types/lodash": "^4.17.16",
    "@types/point-in-polygon": "^1.1.5",
    "@types/polylabel": "^1.1.3",
    "@vis.gl/react-google-maps": "^1.5.2",
    "bgio-firebase": "^0.5.0",
    "boardgame.io": "^0.50.2",
    "chaikin-smooth": "^1.0.4",
    "cross-env": "^7.0.3",
    "csvjson-csv2json": "^5.0.6",
    "express": "^5.1.0",
    "firebase": "^11.5.0",
    "lodash": "^4.17.21",
    "node-persist": "^4.0.4",
    "paper": "^0.12.18",
    "paper-jsdom": "^0.12.18",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "point-in-polygon": "^1.1.0",
    "polylabel": "^2.0.1",
    "react": "^19.0.0",
    "react-countdown": "^2.3.6",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^5.0.0",
    "react-firebase-hooks": "^5.1.1",
    "react-geolocated": "^4.3.0",
    "react-icons": "^5.5.0",
    "react-player": "^2.16.0",
    "react-router": "^7.4.0",
    "react-use-websocket": "^4.13.0",
    "socket.io": "^4.8.1",
    "turf": "^3.0.14",
    "typescript": "^5.8.2",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/xmldom": "^0.1.34",
    "buffer": "^6.0.3",
    "concurrently": "^9.1.2",
    "parcel": "^2.14.1",
    "parse2-kmz": "^1.0.7",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "process": "^0.11.10",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.20.3"
  }
}
