{
  "compilerOptions": {
    "plugins": [{ "name": "typescript-plugin-css-modules" }],
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "outDir": "./build",
    /* Modules */
    "module": "ESNext",
    "moduleResolution": "bundler",

    /* Interop Constraints */
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,

    /* Completeness */
    "skipLibCheck": true,
    "baseUrl" : ".",
    "paths": {
      "@/*": ["./*"],
      "@src/*": ["src/*"],
      "@scripts/*": ["scripts/*"],
      "@server/*": ["server/*"],
      "@data/*": ["./data/*"],
      "@styles/*": ["src/styles/*"],
      "@match/*": ["src/match/*"],
      "react": ["next-app/node_modules/@types/react/index"],
    }

  },

}
